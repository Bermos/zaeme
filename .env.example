DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Getting in ---
#
# zäme has no passwords. Two sign-in methods, and they fail independently:
# a magic link (needs working outbound mail) and a PASSKEY (needs nothing but a
# browser). The WebAuthn relying-party id and origin are derived from
# BETTER_AUTH_URL / BASE_URL — do not configure them a second time.
#
# BREAK-GLASS, unset by default. While this holds a value, anybody who quotes it
# at /setup/recover can register a passkey on THE OWNER's account — and nothing
# else: it is not a session, it cannot name another account, and every use is
# audited. Set it when the owner is locked out (an instance whose mail transport
# is not wired up yet is exactly that), use it once, then REMOVE IT.
#   openssl rand -hex 32
ZAEME_OWNER_BOOTSTRAP_TOKEN=

# Public base URL used in outgoing emails, iCal feeds, and OG links.
# Defaults to BETTER_AUTH_URL when unset.
BASE_URL=

# --- Phase 3: Calendar & Email ---

# Outgoing mail has three transports, tried in this order (server/emails/send.ts):
#
#   1. THE MAIL RELAY — Proton Bridge running as its own workload on the
#      platform (`kitchen-services`, services/proton-bridge), fronted by a small
#      HTTP relay. This is what a self-hosted instance uses. The address comes
#      from the platform binding KITCHEN_SERVICE_MAIL; MAIL_RELAY_URL overrides
#      it for local development. MAIL_RELAY_TOKEN authenticates this instance to
#      the relay and grants exactly one thing: "send this message".
#   2. Resend, for an instance that has an API key instead.
#   3. A dry run — the payload, and every link in it, printed to stdout.
#
# An instance on (3) cannot deliver a magic link. /login and /admin/security say
# so out loud rather than accepting an address and promising an email.
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=

# Resend — https://resend.com
RESEND_API_KEY=
EMAIL_FROM="zäme <hello@your-domain.com>"

# Inngest — https://inngest.com
# When unset, the client runs in local dev mode (Inngest Dev Server).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Phase 7: Media & Documents ---

# Cloudflare R2 (or any S3-compatible storage — MinIO, Garage, etc.)
# When any of these is unset, media upload/list endpoints return 501 and
# the gallery UI is hidden. Leave blank to disable media features.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the default `https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com`
# endpoint. Required for non-Cloudflare S3-compatible stores.
R2_ENDPOINT=

# --- The machine API (ADR-0036): Enterprise → zäme ---
#
# The contract is `docs/zaeme-api.openapi.yaml` (served at /api/openapi.yaml).
# It is a HOST-side, machine-only surface under /api/v1, entirely separate from
# the guest capability URLs and the magic-link host session: a service token is
# never accepted on /api/invites/** or /api/host/**, and a guest session never
# reaches /api/v1/**.

# The shared secret that authenticates ENTERPRISE — the system, not a person.
# Same name on both sides; rotate by replacing it in both places at once. When
# this is unset, every /api/v1 call answers the same 401 as a wrong token, so an
# unconfigured instance is closed rather than open.
ZAEME_SERVICE_TOKEN=

# WHICH Enterprise owner this instance acts for. The `x-mcp-user` header on every
# call must equal this value; anything else is a 403. Deliberately explicit — the
# contract forbids a silent fallback to "the owner" — so an instance with no
# mapping configured accepts nobody. The resolved planner is this zäme
# instance's owner account (the first account registered, see /setup).
ZAEME_ENTERPRISE_OWNER_ID=
