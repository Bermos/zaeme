# =============================================================
# zäme environment variables
# Copy this file to .env and fill in your values.
# =============================================================

# -------------------------------------------------------------
# Database (required)
# Neon PostgreSQL connection string, or any postgres:// URL
# -------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Automatically run migrations on startup (set to true in production)
AUTO_MIGRATE=true

# -------------------------------------------------------------
# Authentication (required)
# Generate a secret with: openssl rand -base64 32
# -------------------------------------------------------------
BETTER_AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32

# The canonical URL of your zäme instance
BETTER_AUTH_URL=http://localhost:3000

# The email address reserved for the admin account.
# On first run, zäme will redirect to /setup to create this account.
ADMIN_EMAIL=you@example.com

# -------------------------------------------------------------
# Application
# -------------------------------------------------------------
BASE_URL=http://localhost:3000

# -------------------------------------------------------------
# File storage — Cloudflare R2 (or any S3-compatible storage)
# -------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# For non-R2 S3-compatible storage (e.g. MinIO), set a custom endpoint:
# S3_ENDPOINT=https://minio.example.com

# -------------------------------------------------------------
# Email — Resend
# https://resend.com — free tier is plenty for personal use
# -------------------------------------------------------------
RESEND_API_KEY=re_...

# The "from" address for transactional emails (must be verified in Resend)
EMAIL_FROM=zaeme@yourdomain.com

# -------------------------------------------------------------
# AI — Anthropic (optional)
# Degrades gracefully if unset. Set ENABLE_AI=false to disable.
# https://console.anthropic.com
# -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------
# Feature flags
# -------------------------------------------------------------

# Enable the AI assistant and MCP server (requires ANTHROPIC_API_KEY)
ENABLE_AI=false

# Enable Fahrgemeinschaft / SBB transit lookup
# Set to false for deployments outside Switzerland
ENABLE_SBB=true

# Enable magic link authentication (requires Resend)
ENABLE_MAGIC_LINK=true
