# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

# PostgreSQL connection string (Neon or any postgres-compatible URL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Used by drizzle-kit CLI commands (db:generate, db:migrate)
NUXT_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────

# Secret used to sign session tokens — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Base URL of your deployment (used by better-auth for redirect URLs)
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────

# Enable magic link authentication (requires Resend to be configured)
ENABLE_MAGIC_LINK=false

# Enable AI assistant (requires ANTHROPIC_API_KEY)
ENABLE_AI=false

# Enable SBB travel group clustering (Switzerland only)
# Set to false to fall back to a Google Maps directions link
ENABLE_SBB=true

# ─────────────────────────────────────────────
# Email — Resend (required for transactional email and magic links)
# ─────────────────────────────────────────────

RESEND_API_KEY=re_your_api_key_here

# The "from" address used for outgoing emails
EMAIL_FROM=zäme <noreply@example.com>

# ─────────────────────────────────────────────
# File storage — Cloudflare R2 (or any S3-compatible storage)
# ─────────────────────────────────────────────

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=zaeme-media

# Optional: custom S3-compatible endpoint (leave blank for Cloudflare R2)
# R2_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Public base URL for serving media (R2 public bucket URL or CDN)
R2_PUBLIC_URL=https://pub-your_account_id.r2.dev

# ─────────────────────────────────────────────
# Background jobs — Inngest
# ─────────────────────────────────────────────

INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ─────────────────────────────────────────────
# AI assistant — Anthropic (required when ENABLE_AI=true)
# ─────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-your_api_key_here
