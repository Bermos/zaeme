{
  "$schema": "https://raw.githubusercontent.com/Bermos/Kitchen/main/docs/schemas/kitchen.schema.json",
  "build": {
    "strategy": "dockerfile"
  },
  "runtime": {
    "port": 3000,
    "health": {
      "path": "/healthz"
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "processes": [
    {
      "name": "migrate",
      "type": "task",
      "command": [
        "node",
        "scripts/migrate.mjs"
      ],
      "timeout": "10m"
    }
  ]
}
